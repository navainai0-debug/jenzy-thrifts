+async function routes(ctx) {
+    await ctx.route(/^https?:\/\/(?!localhost)/, async (route) => {
+        const u = route.request().url();
+        if (u.includes('firebase-app-compat')) return route.fulfill({ contentType: 'text/javascript', body: fs.readFileSync(path.join(HERE, 'stubs/firebase-app.js')) });
+        if (u.includes('firebase-auth-compat')) return route.fulfill({ contentType: 'text/javascript', body: fs.readFileSync(path.join(HERE, 'stubs/firebase-auth.js')) });

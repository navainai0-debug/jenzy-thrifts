+    await pg.close();
+    pg = await open(m, '/orders.html#invite', 'cust');
+    await pg.waitForSelector('.invite-code');
+    await noOverflow(pg, `orders ${w}`);
+    await shot(pg, `orders-${w}`);
+    await pg.close();
+    pg = await open(m, '/sell.html', 'cust');
+    await pg.waitForSelector('#myRequests .sell-req');
+    await noOverflow(pg, `sell ${w}`);
+    await shot(pg, `sell-${w}`);
+    await pg.close();
+    pg = await open(m, '/admin.html#visitors', 'admin');
+    await pg.waitForSelector('#visitStats .stat');
+    await noOverflow(pg, `admin visitors ${w}`);
+    await shot(pg, `admin-visitors-${w}`);
+    await pg.goto(BASE + '/admin.html#sell');
+    await pg.waitForSelector('#sellTabs .tab');
+    await pg.click('#sellTabs [data-tab="All"]');
+    await noOverflow(pg, `admin sell ${w}`);
+    await shot(pg, `admin-sell-${w}`);
+    await pg.goto(BASE + '/admin.html#products');
+    await pg.waitForSelector(`[data-story="${P1.id}"]`);
+    await pg.click(`[data-story="${P1.id}"]`);
+    await pg.waitForFunction(() => !document.getElementById('storyLoading').classList.contains('show'));
+    await sleep(300);
+    await shot(pg, `admin-story-${w}`, false);
+    await pg.close();
+}
+
+const expected = [/whoami.*403/, /telegramConnect/, /Failed to load resource.*403/];
+const real = errors.filter(e => !expected.some(r => r.test(e)));
+console.log('\nConsole errors:', real.length ? '\n  ' + real.join('\n  ') : 'none');
+ok(!real.some(e => e.startsWith('[pageerror]')), 'no JavaScript errors on any page');

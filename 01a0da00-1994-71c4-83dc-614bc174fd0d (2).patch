+// Firebase compat stub: the signed-in user comes from localStorage 'stubUser'
+// ('cust' | 'admin' | 'cust2'); the ID token is simply that key.
+(function () {
+    const USERS = {
+        cust: { uid: 'u-cust', email: 'ali@gmail.com', displayName: 'Ali Khan' },
+        cust2: { uid: 'u-cust2', email: 'sara@gmail.com', displayName: 'Sara Ahmed' },
+        cust3: { uid: 'u-cust3', email: 'zara@gmail.com', displayName: 'Zara Malik' },
+        admin: { uid: 'u-admin', email: 'owner@gmail.com', displayName: 'Shop Owner' }
+    };
+    const listeners = [];
+    function current() {
+        const k = localStorage.getItem('stubUser');
+        const u = USERS[k];
+        return u ? { ...u, photoURL: '', emailVerified: true, getIdToken: async () => k } : null;
+    }
+    const auth = {
+        get currentUser() { return current(); },
+        onAuthStateChanged(cb) { listeners.push(cb); setTimeout(() => cb(current()), 0); return () => {}; },
+        async signInWithPopup() {
+            localStorage.setItem('stubUser', localStorage.getItem('stubNext') || 'cust');
+            listeners.forEach(cb => cb(current()));
+            return { user: current() };
+        },
+        async signInWithRedirect() { return this.signInWithPopup(); },
+        async signInWithEmailAndPassword() { return this.signInWithPopup(); },
+        async getRedirectResult() { return { user: null }; },
+        async signOut() { localStorage.removeItem('stubUser'); listeners.forEach(cb => cb(null)); },
+        setPersistence: async () => {}
+    };
+    function GoogleAuthProvider() {}
+    GoogleAuthProvider.prototype.setCustomParameters = function () {};
+    GoogleAuthProvider.prototype.addScope = function () {};
+    const authFn = () => auth;
+    authFn.GoogleAuthProvider = GoogleAuthProvider;
+    authFn.Auth = { Persistence: { LOCAL: 'local' } };
+    window.firebase = { initializeApp: () => ({}), auth: authFn, apps: [] };
+})();

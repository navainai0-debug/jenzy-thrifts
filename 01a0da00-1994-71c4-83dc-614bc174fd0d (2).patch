+.checkout-section h3 .n { width: 26px; height: 26px; border-radius: 8px; background: var(--surface-2); border: 1px solid var(--border-2); font-size: 13px; display: inline-flex; align-items: center; justify-content: center; color: var(--accent); }
+.pay-option { display: flex; gap: 14px; align-items: center; padding: 16px 18px; border-radius: var(--radius); border: 1px solid var(--accent); background: rgba(57, 255, 20, .05); }
+.pay-option .radio { width: 20px; height: 20px; border-radius: 50%; border: 2px solid var(--accent); display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
+.pay-option .radio::after { content: ''; width: 10px; height: 10px; border-radius: 50%; background: var(--accent); }
+.pay-option strong { display: block; font-size: 15px; }
+.pay-option span { font-size: 13px; color: var(--text-3); }
+.pay-option i { margin-left: auto; font-size: 22px; color: var(--accent); }
+.summary { position: sticky; top: calc(var(--header-h) + 20px); }
+.sum-item { display: grid; grid-template-columns: 60px 1fr auto; gap: 12px; align-items: center; padding: 12px 0; border-bottom: 1px solid var(--border); }
+.sum-item img { width: 60px; height: 60px; border-radius: 10px; object-fit: cover; background: var(--bg); }
+.sum-item h5 { font-size: 14px; font-weight: 600; line-height: 1.3; }

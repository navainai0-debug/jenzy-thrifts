+.pd-price .now { font-size: 30px; font-weight: 700; }
+.pd-price .was { font-size: 17px; color: var(--text-3); text-decoration: line-through; }
+.pd-price .save { font-size: 13px; font-weight: 700; color: var(--accent); background: rgba(57, 255, 20, .08); padding: 4px 10px; border-radius: 8px; }

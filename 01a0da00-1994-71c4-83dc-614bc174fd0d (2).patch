diff --git a/dev-tests/png.mjs b/dev-tests/png.mjs
new file mode 100644
index 0000000..d1d6bce
--- /dev/null
+++ b/dev-tests/png.mjs
@@ -0,0 +1,24 @@
+// Minimal PNG encoder (no dependencies) for placeholder/test photos
+import zlib from 'zlib';
+function chunk(type, data) {
+    const len = Buffer.alloc(4); len.writeUInt32BE(data.length);
+    const td = Buffer.concat([Buffer.from(type), data]);
+    const crc = Buffer.alloc(4); crc.writeUInt32BE(zlib.crc32(td) >>> 0);
+    return Buffer.concat([len, td, crc]);
+}
+export function makePng(w, h, color = [200, 60, 60], seed = 0) {
+    const raw = Buffer.alloc((w * 3 + 1) * h);
+    for (let y = 0; y < h; y++) {
+        raw[y * (w * 3 + 1)] = 0;
+        for (let x = 0; x < w; x++) {
+            const o = y * (w * 3 + 1) + 1 + x * 3;
+            const d = Math.hypot(x - w / 2, y - h / 2) / (w / 2);
+            const shoe = d < 0.55 && y > h * 0.35;
+            const [r, g, b] = shoe ? color : [245 - (seed * 7) % 30, 245, 240];
+            raw[o] = r; raw[o + 1] = g; raw[o + 2] = b;
+        }
+    }
+    const ihdr = Buffer.alloc(13);
+    ihdr.writeUInt32BE(w, 0); ihdr.writeUInt32BE(h, 4); ihdr[8] = 8; ihdr[9] = 2; ihdr[10] = 0; ihdr[11] = 0; ihdr[12] = 0;
+    return Buffer.concat([Buffer.from([137, 80, 78, 71, 13, 10, 26, 10]), chunk('IHDR', ihdr), chunk('IDAT', zlib.deflateSync(raw)), chunk('IEND', Buffer.alloc(0))]);
+}
diff --git a/dev-tests/server.mjs b/dev-tests/server.mjs
new file mode 100644
index 0000000..58c49a0
--- /dev/null
+++ b/dev-tests/server.mjs
@@ -0,0 +1,92 @@
+// Local test server: static site + real /api handlers on a fake Supabase (PGlite).
+//   node dev-tests/server.mjs [port]
+import http from 'node:http';
+import fs from 'node:fs';
+import path from 'node:path';
+import { fileURLToPath, pathToFileURL } from 'node:url';
+import { setupEnv } from './testenv.mjs';
+import { makePng } from './png.mjs';
+
+const ROOT = path.resolve(path.dirname(fileURLToPath(import.meta.url)), '..');
+process.chdir(ROOT);
+export async function startServer(port = 3000) {
+    const env = await setupEnv();
+    const { db } = env;
+    const uploads = new Map();   // storage path -> { type, body }
+    const handlers = {};
+    const getHandler = async (name) => handlers[name] ||= (await import(pathToFileURL(path.join(ROOT, 'api', name + '.js')).href)).default;
+    const MIME = { '.html': 'text/html; charset=utf-8', '.js': 'text/javascript', '.css': 'text/css', '.json': 'application/json', '.png': 'image/png', '.svg': 'image/svg+xml', '.ico': 'image/x-icon', '.webp': 'image/webp', '.jpg': 'image/jpeg' };
+    const COLORS = [[220, 40, 60], [30, 120, 220], [40, 170, 90], [240, 160, 20], [140, 60, 200], [30, 30, 30]];
+    const placeholders = new Map();
+    const placeholder = (p) => {
+        if (!placeholders.has(p)) { let h = 0; for (const c of p) h = (h * 31 + c.charCodeAt(0)) >>> 0; placeholders.set(p, makePng(600, 600, COLORS[h % COLORS.length], h)); }
+        return placeholders.get(p);
+    };
+    const readBody = (req) => new Promise((resolve) => { const parts = []; req.on('data', c => parts.push(c)); req.on('end', () => resolve(Buffer.concat(parts))); });
+    function wrapRes(res) {
+        res.status = (c) => { res.statusCode = c; return res; };
+        res.json = (o) => { if (!res.getHeader('content-type')) res.setHeader('content-type', 'application/json'); res.end(JSON.stringify(o)); return res; };
+        res.send = (o) => { res.end(typeof o === 'string' || Buffer.isBuffer(o) ? o : JSON.stringify(o)); return res; };
+        return res;
+    }
+    async function runApi(name, req, res, url, extraQuery = {}) {
+        const body = await readBody(req);
+        const query = { ...Object.fromEntries(url.searchParams.entries()), ...extraQuery };
+        let parsed;
+        if (body.length) { try { parsed = JSON.parse(body.toString()); } catch { parsed = body.toString(); } }
+        const vreq = { method: req.method, headers: req.headers, query, body: parsed, url: req.url };
+        const h = await getHandler(name);
+        await h(vreq, wrapRes(res));
+    }
+    const server = http.createServer(async (req, res) => {
+        const url = new URL(req.url, 'http://localhost');
+        const p = decodeURIComponent(url.pathname);
+        try {
+            if (p === '/__db' && req.method === 'POST') {
+                const spec = JSON.parse((await readBody(req)).toString());
+                const out = spec.rpc ? await db.anonClient.rpc(spec.rpc, spec.args) : await db.anon(spec);
+                res.setHeader('content-type', 'application/json');
+                return res.end(JSON.stringify(out));
+            }
+            if (p === '/__sql' && req.method === 'POST') {
+                const { q, params } = JSON.parse((await readBody(req)).toString());
+                const out = await db.pg.query(q, params || []);
+                res.setHeader('content-type', 'application/json');
+                return res.end(JSON.stringify({ rows: out.rows }));
+            }
+            if (p === '/__mails') { res.setHeader('content-type', 'application/json'); return res.end(JSON.stringify(env.mails.map(m => ({ to: m.to, subject: m.subject, html: m.html })))); }
+            if (p === '/__upload' && req.method === 'POST') {
+                uploads.set(url.searchParams.get('path'), { type: req.headers['content-type'] || 'application/octet-stream', body: await readBody(req) });
+                res.setHeader('content-type', 'application/json');
+                return res.end('{"ok":true}');
+            }
+            if (p === '/__uploads') { res.setHeader('content-type', 'application/json'); return res.end(JSON.stringify([...uploads].map(([k, v]) => ({ path: k, type: v.type, size: v.body.length })))); }
+            let m;
+            if ((m = p.match(/^\/storage\/v1\/object\/public\/[^/]+\/(.+)$/))) {
+                const up = uploads.get(m[1]);
+                res.setHeader('access-control-allow-origin', '*');
+                res.setHeader('content-type', up ? up.type : 'image/png');
+                return res.end(up ? up.body : placeholder(m[1]));
+            }
+            if ((m = p.match(/^\/api\/([a-z]+)$/))) return await runApi(m[1], req, res, url);
+            if ((m = p.match(/^\/shoe\/([^/]+)$/))) return await runApi('shoe', req, res, url, { id: m[1] });
+            if ((m = p.match(/^\/assets\/img\/([^/]+)$/))) return await runApi('shoe', req, res, url, { img: m[1] });
+            let file = path.join(ROOT, p === '/' ? 'index.html' : p);
+            if (!file.startsWith(ROOT) || !fs.existsSync(file) || fs.statSync(file).isDirectory()) { res.statusCode = 404; return res.end('Not found'); }
+            res.setHeader('content-type', MIME[path.extname(file)] || 'application/octet-stream');
+            res.end(fs.readFileSync(file));
+        } catch (e) {
+            console.error('[server]', req.method, req.url, e);
+            if (!res.headersSent) res.statusCode = 500;
+            res.end(JSON.stringify({ error: e.message }));
+        }
+    });
+    await new Promise(r => server.listen(port, '0.0.0.0', r));
+    return { server, db, env, uploads };
+}
+
+if (process.argv[1] && fileURLToPath(import.meta.url) === path.resolve(process.argv[1])) {
+    const port = Number(process.argv[2]) || 3000;
+    await startServer(port);
+    console.log('test server on http://localhost:' + port);
+}
diff --git a/dev-tests/sqltest.mjs b/dev-tests/sqltest.mjs
new file mode 100644
index 0000000..9363258
--- /dev/null
+++ b/dev-tests/sqltest.mjs
@@ -0,0 +1,202 @@
+// SQL tests: node dev-tests/sqltest.mjs
+import fs from 'node:fs';
+import path from 'node:path';
+import { fileURLToPath } from 'node:url';
+import { makeDb } from './fakedb.mjs';
+
+const ROOT = path.resolve(path.dirname(fileURLToPath(import.meta.url)), '..');
+const SQL = fs.readFileSync(path.join(ROOT, 'supabase-setup.sql'), 'utf8');
+let pass = 0, fail = 0;
+const ok = (c, name, extra) => { if (c) { pass++; console.log('  ✓', name); } else { fail++; console.log('  ✗', name, extra !== undefined ? JSON.stringify(extra) : ''); } };
+
+const db = await makeDb();
+await db.pg.exec(SQL);           // run twice: must be idempotent
+ok(true, 'setup SQL runs twice');
+
+const one = async (q, p) => (await db.pg.query(q, p)).rows[0];
+async function product(name, price, sizes = ['8', '9', '10'], status = 'Active') {
+    return (await one(`insert into products (name, brand, price, sizes, status, images, thumbs) values ($1, 'Nike', $2, $3, $4, '{https://x/a.jpg}', '{https://x/a-t.webp}') returning id`, [name, price, sizes, status])).id;
+}
+const place = (uid, items, code = null) => db.rpc('place_order', {
+    p_user_uid: uid, p_user_email: uid + '@x.com', p_customer_name: 'Test ' + uid, p_phone: '03001234567',
+    p_address: 'House 1 Street 2', p_city: 'Lahore', p_notes: '', p_items: items, p_coupon: code,
+    p_discount_percent: 0, p_delivery_fee: 250, p_free_delivery_min: 5000
+});
+const status = (id, s) => db.rpc('set_order_status', { p_order_id: id, p_status: s, p_by: 'admin' });
+
+// ---------- defaults ----------
+const bundle = await one(`select value from shop_settings where key = 'bundle'`);
+ok(bundle && bundle.value.min === 2 && bundle.value.percent === 10, 'bundle default row', bundle);
+const refc = await one(`select value from shop_settings where key = 'referral'`);
+ok(refc && refc.value.reward === 300 && refc.value.percent === 10, 'referral default row', refc);
+const cols = (await db.pg.query(`select column_name from information_schema.columns where table_name = 'products' and column_name in ('fit','thumbs')`)).rows.length;
+ok(cols === 2, 'products.fit and products.thumbs exist');
+
+// ---------- place_order discounts ----------
+const A = await product('Air Max', 4000);
+const B = await product('Dunk', 3000);
+const C = await product('Jordan', 6000);
+let r = await place('u1', [{ product_id: A, size: '8' }]);
+ok(!r.error && r.data.discount === 0 && r.data.discount_type === null && r.data.delivery_fee === 250 && r.data.total === 4250, 'single pair: no discount + delivery fee', r);
+ok(r.data.items[0].image === 'https://x/a-t.webp', 'order item uses the thumbnail');
+const firstOrder = r.data;
+
+r = await place('u2', [{ product_id: A, size: '9' }, { product_id: B, size: '8' }]);
+ok(!r.error && r.data.discount === 700 && r.data.discount_type === 'bundle' && r.data.coupon === null && r.data.total === 6300, 'two pairs: bundle 10%', r);
+
+await db.pg.query(`insert into coupons (code, percent, min_order, active) values ('BIG20', 20, 0, true), ('SMALL5', 5, 0, true), ('MIN9K', 15, 9000, true)`);
+r = await place('u3', [{ product_id: A, size: '10' }, { product_id: B, size: '9' }], 'big20');
+ok(!r.error && r.data.discount === 1400 && r.data.discount_type === 'coupon' && r.data.coupon === 'BIG20', 'coupon 20% beats bundle 10%', r);
+ok((await one(`select used_count from coupons where code = 'BIG20'`)).used_count === 1, 'winning coupon counted');
+
+r = await place('u4', [{ product_id: C, size: '8' }, { product_id: B, size: '10' }], 'SMALL5');
+ok(!r.error && r.data.discount_type === 'bundle' && r.data.discount === 900 && r.data.coupon === null, 'bundle beats smaller coupon', r);
+ok((await one(`select used_count from coupons where code = 'SMALL5'`)).used_count === 0, 'losing coupon NOT counted');
+
+r = await place('u5', [{ product_id: C, size: '9' }], 'MIN9K');
+ok(r.error && /^COUPON:.*at least PKR 9000/.test(r.error.message), 'coupon minimum order still enforced', r.error);
+ok((await one(`select sizes from products where id = $1`, [C])).sizes.includes('9'), 'failed order rolled back stock');
+
+r = await place('u5', [{ product_id: C, size: '9' }], 'NOPE');
+ok(r.error && /^COUPON:Coupon "NOPE" is not valid/.test(r.error.message), 'unknown code rejected', r.error);
+
+// ---------- referral ----------
+await db.pg.query(`insert into referral_codes (code, user_uid, name) values ('ALIKH123', 'u1', 'Ali')`);
+r = await place('u1', [{ product_id: C, size: '9' }], 'ALIKH123');

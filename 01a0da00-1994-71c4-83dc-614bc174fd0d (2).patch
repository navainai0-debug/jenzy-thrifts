+<script src="assets/js/store.js"></script>
+<script>
+(function () {
+    const { esc, pkr, api } = Store;
+    const $ = (id) => document.getElementById(id);
+
+    // Buy Now → checkout.html?buy=<id>&size=<size>  (just that pair)
+    const buyId = Store.qs('buy');
+    const buySize = Store.qs('size');
+    const buyNow = !!(buyId && buySize);
+
+    let quote = null;
+    // A typed code, or a friend's invite code saved from an invite link (?ref=CODE)
+    let coupon = sessionStorage.getItem('jenzyCoupon') || Store.referralCode() || '';
+    let placing = false;
+
+    const items = () => buyNow ? [{ id: buyId, size: buySize }] : Store.cart.items.map(i => ({ id: i.id, size: i.size }));
+
+    if (buyNow) $('modeNote').textContent = 'Buy Now — you are ordering this pair only. Your cart is not affected.';
+
+    async function refreshQuote() {
+        const list = items();
+        if (!list.length) {
+            $('checkoutGrid').hidden = true;
+            $('emptyState').hidden = false;
+            return;
+        }
+        $('checkoutGrid').hidden = false;
+        $('emptyState').hidden = true;
+        try {
+            quote = await api('/api/orders?action=quote', {
+                method: 'POST',
+                body: { items: list.map(i => ({ product_id: i.id, size: i.size })), coupon }
+            });
+        } catch (e) {
+            $('summaryItems').innerHTML = `<div class="alert show">${esc(e.message)}</div>`;
+            quote = null;
+            updateButton();
+            return;
+        }
+        if (quote.couponError) {
+            $('couponMsg').textContent = quote.couponError;
+            $('couponMsg').className = 'coupon-msg err';
+            if (coupon === Store.referralCode()) Store.clearReferralCode();
+            coupon = '';
+            sessionStorage.removeItem('jenzyCoupon');
+        } else if (quote.codeKind) {
+            $('couponInput').value = coupon;
+            if (quote.coupon) {
+                $('couponMsg').textContent = quote.codeKind === 'referral'
+                    ? `Friend's invite code applied: ${quote.couponPercent}% off your first order`
+                    : `Code ${quote.coupon} applied: ${quote.couponPercent}% off`;
+                $('couponMsg').className = 'coupon-msg ok';
+            } else {
+                $('couponMsg').textContent = quote.couponNote || '';
+                $('couponMsg').className = 'coupon-msg info';
+            }
+        } else {
+            $('couponMsg').textContent = '';
+            $('couponMsg').className = 'coupon-msg';
+        }
+        renderSummary();
+    }
+
+    function renderSummary() {
+        const q = quote;
+        $('summaryItems').innerHTML = q.items.map(it => `
+            <div class="sum-item ${it.available ? '' : 'unavailable'}">
+                <a href="${Store.productUrl(it.product_id)}"><img src="${esc(it.image || Store.firstImage({}))}" alt=""></a>
+                <div>
+                    <h5>${esc(it.name)}</h5>
+                    <small>${esc(it.brand || '')} • US ${esc(it.size)}</small>
+                    ${it.available ? '' : `<span class="flag">${esc(it.reason || 'Sold out')}</span>`}
+                    ${!it.available && !buyNow ? `<button class="rm" data-rm="${esc(it.product_id)}" data-size="${esc(it.size)}">Remove</button>` : ''}
+                </div>
+                <span class="price">${it.available ? pkr(it.price) : '—'}</span>
+            </div>`).join('');
+        $('summaryItems').querySelectorAll('[data-rm]').forEach(b => b.addEventListener('click', () => {
+            Store.cart.remove(b.dataset.rm, b.dataset.size);
+            refreshQuote();
+        }));
+
+        const alertBox = $('availAlert');
+        if (!q.allAvailable) {
+            alertBox.textContent = buyNow
+                ? 'Sorry, this pair was just sold. Please choose another shoe.'
+                : 'Some items are no longer available. Remove them to continue.';
+            alertBox.classList.add('show');
+        } else {
+            alertBox.classList.remove('show');
+        }
+
+        $('sSubtotal').textContent = pkr(q.subtotal);
+        $('discountRow').hidden = !q.discount;
+        $('sDiscount').textContent = '− ' + pkr(q.discount);
+        $('sDiscountLabel').textContent = q.discountLabel || 'Discount';
+        // Bundle deal / invite credit notes
+        let deal = '';
+        if (q.discountType === 'credit') deal = `<i class="fas fa-gift"></i> Your invite credit of ${pkr(q.credit.amount)} is applied. Thanks for inviting friends!`;
+        else if (q.bundleHint) deal = `<i class="fas fa-tags"></i> ${esc(q.bundleHint)} <a href="index.html#shop">Browse shoes</a>`;
+        else if (q.discountType === 'bundle') deal = `<i class="fas fa-tags"></i> Bundle deal applied: ${q.bundle.percent}% off for ${q.bundle.min}+ pairs.`;
+        else if (q.credit && !q.credit.applied) deal = `<i class="fas fa-gift"></i> You have ${pkr(q.credit.amount)} invite credit. It is kept for your next order because a bigger discount is used now.`;
+        $('dealNote').innerHTML = deal;
+        $('dealNote').className = 'deal-note' + (q.discountType === 'bundle' || q.discountType === 'credit' ? ' on' : '');
+        $('dealNote').hidden = !deal;
+        $('sDelivery').textContent = q.subtotal === 0 ? '–' : (q.deliveryFee ? pkr(q.deliveryFee) : 'Free');
+        $('sTotal').textContent = pkr(q.total);
+        const after = q.subtotal - q.discount;
+        $('freeNote').textContent = q.deliveryFee && q.freeDeliveryMin
+            ? `Add ${pkr(q.freeDeliveryMin - after)} more for free delivery.`
+            : (q.subtotal ? 'You get free delivery on this order.' : '');
+        updateButton();
+    }
+
+    function updateButton() {
+        const ok = quote && quote.allAvailable && quote.subtotal > 0 && Store.user && !placing;
+        $('placeBtn').disabled = !ok;
+        $('placeBtn').innerHTML = !Store.user
+            ? '<i class="fa-regular fa-user"></i> Log in to place order'
+            : '<i class="fas fa-lock"></i> Place order' + (quote && quote.total ? ' • ' + pkr(quote.total) : '');
+        if (!Store.user && quote && quote.allAvailable) $('placeBtn').disabled = false;
+    }
+
+    // ---------- Login state ----------
+    const savedKey = (uid) => 'jenzyCheckout.' + uid;
+    Store.onAuth(user => {
+        $('loginGate').hidden = !!user;
+        $('orderForm').hidden = !user;
+        if (user) {
+            $('accountEmail').textContent = user.email || user.displayName || '';
+            let saved = {};
+            try { saved = JSON.parse(localStorage.getItem(savedKey(user.uid))) || {}; } catch { saved = {}; }
+            const fill = (id, v) => { if (!$(id).value && v) $(id).value = v; };
+            fill('fName', saved.name || user.displayName);
+            fill('fPhone', saved.phone);
+            fill('fCity', saved.city);
+            fill('fArea', saved.area);
+            fill('fAddress', saved.address);
+        }
+        updateButton();
+        // Logged in / out changes invite codes and credit
+        if (quote && !placing) refreshQuote();
+    });
+    $('gateLogin').addEventListener('click', () => Store.requireLogin('Log in to place your order.').catch(() => {}));
+
+    // ---------- Coupon ----------
+    $('couponBtn').addEventListener('click', async () => {
+        const code = $('couponInput').value.trim().toUpperCase();
+        $('couponMsg').className = 'coupon-msg';
+        $('couponMsg').textContent = '';
+        coupon = code;
+        if (code) sessionStorage.setItem('jenzyCoupon', code); else sessionStorage.removeItem('jenzyCoupon');
+        $('couponBtn').disabled = true;
+        await refreshQuote();
+        $('couponBtn').disabled = false;
+    });
+    $('couponInput').addEventListener('keydown', e => { if (e.key === 'Enter') { e.preventDefault(); $('couponBtn').click(); } });
+
+    // ---------- Place order ----------
+    function validate() {
+        const name = $('fName').value.trim();
+        const phoneDigits = $('fPhone').value.replace(/\D/g, '');
+        const city = $('fCity').value.trim();
+        const address = $('fAddress').value.trim();
+        if (name.length < 2) return ['fName', 'Please enter your full name.'];
+        if (phoneDigits.length < 10 || phoneDigits.length > 15) return ['fPhone', 'Please enter a valid phone number, e.g. 03001234567.'];
+        if (city.length < 2) return ['fCity', 'Please enter your city.'];
+        if (address.length < 10) return ['fAddress', 'Please enter your full delivery address (house, street, area).'];
+        return null;
+    }
+
+    $('placeBtn').addEventListener('click', async () => {
+        const alertBox = $('orderAlert');
+        alertBox.className = 'alert';
+        if (!Store.user) {
+            try { await Store.requireLogin('Log in to place your order.'); } catch { return; }
+            return;
+        }
+        const invalid = validate();
+        if (invalid) {
+            alertBox.textContent = invalid[1];
+            alertBox.className = 'alert show';
+            $(invalid[0]).focus();
+            $(invalid[0]).scrollIntoView({ behavior: 'smooth', block: 'center' });
+            return;
+        }
+        const area = $('fArea').value.trim();
+        const customer = {
+            name: $('fName').value.trim(),
+            phone: $('fPhone').value.trim(),
+            city: $('fCity').value.trim(),
+            address: $('fAddress').value.trim() + (area ? ', ' + area : ''),
+            notes: $('fNotes').value.trim()
+        };
+        placing = true;
+        updateButton();
+        $('placeBtn').innerHTML = '<i class="fas fa-spinner fa-spin"></i> Placing your order…';
+        try {
+            const { order } = await api('/api/orders?action=place', {
+                method: 'POST', auth: true,
+                body: { items: items().map(i => ({ product_id: i.id, size: i.size })), customer, coupon: quote && quote.codeKind ? coupon : '' }
+            });
+            localStorage.setItem(savedKey(Store.user.uid), JSON.stringify({
+                name: customer.name, phone: customer.phone, city: customer.city, area, address: $('fAddress').value.trim()
+            }));
+            // Remove ordered pairs from the cart
+            items().forEach(i => Store.cart.remove(i.id, i.size));
+            sessionStorage.removeItem('jenzyCoupon');
+            if (quote && quote.codeKind === 'referral') Store.clearReferralCode();
+            location.replace('orders.html?placed=' + encodeURIComponent(order.order_no));
+        } catch (e) {
+            placing = false;
+            alertBox.textContent = e.message;
+            alertBox.className = 'alert show';
+            if (e.status === 409) await refreshQuote();
+            else updateButton();
+        }
+    });
+
+    $('orderForm').addEventListener('input', () => $('orderAlert').classList.remove('show'));
+
+    refreshQuote();
+    // Keep prices/stock fresh while the customer fills the form
+    Store.onProductsChange(() => { if (!placing) refreshQuote(); });
+    document.addEventListener('visibilitychange', () => { if (!document.hidden && !placing) refreshQuote(); });
+})();
+</script>
+</body>
+</html>
diff --git a/dev-tests/apitest.mjs b/dev-tests/apitest.mjs
new file mode 100644
index 0000000..25284b4
--- /dev/null
+++ b/dev-tests/apitest.mjs
@@ -0,0 +1,254 @@
+// API tests: node dev-tests/apitest.mjs
+import path from 'node:path';
+import { fileURLToPath } from 'node:url';
+import { setupEnv, call } from './testenv.mjs';
+
+const ROOT = path.resolve(path.dirname(fileURLToPath(import.meta.url)), '..');
+const { db, mails, telegrams } = await setupEnv();
+const orders = (await import(path.join(ROOT, 'api/orders.js'))).default;
+const admin = (await import(path.join(ROOT, 'api/admin.js'))).default;
+const cron = (await import(path.join(ROOT, 'api/cron.js'))).default;
+
+let pass = 0, fail = 0;
+const ok = (c, name, extra) => { if (c) { pass++; console.log('  ✓', name); } else { fail++; console.log('  ✗', name, extra !== undefined ? JSON.stringify(extra).slice(0, 600) : ''); } };
+const one = async (q, p) => (await db.pg.query(q, p)).rows[0];
+const IMG = 'https://zurvhjraxenbnvmwdurz.supabase.co/storage/v1/object/public/product-images/';
+async function product(name, price, sizes = ['8', '9', '10'], extra = {}) {
+    const r = await call(admin, { method: 'POST', query: { action: 'saveProduct' }, user: 'admin', body: { product: { name, brand: 'Nike', price, sizes, status: 'Active', images: [IMG + 'shoes/' + name + '.jpg'], ...extra } } });
+    if (r.status !== 200) throw new Error('product ' + JSON.stringify(r.body));
+    return r.body.product;
+}
+const O = (action, opts = {}) => call(orders, { method: opts.method || 'POST', query: { action }, ...opts });
+const A = (action, opts = {}) => call(admin, { user: 'admin', ...opts, method: opts.method || 'POST', query: { action, ...(opts.query || {}) } });
+const customer = { name: 'Sara Ahmed', phone: '03001234567', city: 'Karachi', address: 'House 5, Street 9, DHA Phase 6' };
+
+// ---------- products: fit + thumbs ----------
+const p1 = await product('AirMax', 4000, ['8', '9', '10'], { fit: 'Runs small', thumbs: [IMG + 'shoes/AirMax-t.webp'] });
+ok(p1.fit === 'Runs small' && p1.thumbs[0] === IMG + 'shoes/AirMax-t.webp', 'saveProduct stores fit + thumbs', p1);
+const p2 = await product('Dunk', 3000, ['8', '9'], { fit: 'bogus' });
+ok(p2.fit === null && p2.thumbs.length === 0, 'bad fit ignored, no thumbs = []', p2);
+let r = await A('setThumbs', { body: { id: p2.id, thumbs: [IMG + 'shoes/Dunk-t.webp'] } });
+ok(r.status === 200 && r.body.product.thumbs[0] === IMG + 'shoes/Dunk-t.webp', 'setThumbs', r.body);
+r = await A('setThumbs', { body: { id: p2.id, thumbs: ['javascript:alert(1)'] } });
+ok(r.status === 200 && r.body.product.thumbs[0] === IMG + 'shoes/Dunk-t.webp', 'setThumbs ignores bad urls', r.body);
+
+// ---------- quote ----------
+r = await O('quote', { body: { items: [{ product_id: p1.id, size: '8' }] } });
+ok(r.status === 200 && r.body.discount === 0 && /Add 1 more pair and get 10% off/.test(r.body.bundleHint) && r.body.items[0].image.endsWith('AirMax-t.webp'), 'quote: single pair gets bundle hint + thumb', r.body);
+r = await O('quote', { body: { items: [{ product_id: p1.id, size: '8' }, { product_id: p2.id, size: '8' }] } });
+ok(r.body.discountType === 'bundle' && r.body.discount === 700 && r.body.total === 6300 + 0 + 250 - 250 + 0 || r.body.total === 6550, 'quote: bundle 10%', r.body);
+ok(r.body.bundleHint === null && /Bundle|deal/i.test(r.body.discountLabel), 'quote: bundle label', r.body.discountLabel);
+await db.pg.query(`insert into coupons (code, percent, min_order, active) values ('SMALL5', 5, 0, true), ('BIG25', 25, 0, true)`);
+r = await O('quote', { body: { items: [{ product_id: p1.id, size: '8' }, { product_id: p2.id, size: '8' }], coupon: 'small5' } });

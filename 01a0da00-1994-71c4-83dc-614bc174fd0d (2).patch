+// Shared test environment: env vars, fake login, captured emails/Telegram.
+import { makeDb } from './fakedb.mjs';
+
+export const USERS = {
+    cust: { sub: 'u-cust', email: 'ali@gmail.com', name: 'Ali Khan', email_verified: true },
+    cust2: { sub: 'u-cust2', email: 'sara@gmail.com', name: 'Sara Ahmed', email_verified: true },
+    cust3: { sub: 'u-cust3', email: 'zara@gmail.com', name: 'Zara Malik', email_verified: true },
+    admin: { sub: 'u-admin', email: 'owner@gmail.com', name: 'Shop Owner', email_verified: true }
+};
+
+export async function setupEnv({ email = true, telegram = true } = {}) {
+    process.env.ADMIN_EMAILS = 'owner@gmail.com';
+    process.env.SITE_URL = process.env.SITE_URL || 'https://jenzy-thrifts.vercel.app';
+    if (email) { process.env.GMAIL_USER = 'shop@gmail.com'; process.env.GMAIL_APP_PASSWORD = 'abcd efgh ijkl mnop'; }
+    if (telegram) { process.env.TELEGRAM_BOT_TOKEN = 'test-token'; process.env.TELEGRAM_CHAT_ID = '42'; }
+    const db = await makeDb();
+    globalThis.__JENZY_TEST_DB__ = db;
+    globalThis.__JENZY_TEST_VERIFY__ = async (token) => {
+        if (!USERS[token]) throw new Error('bad token');
+        return USERS[token];
+    };
+    const mails = [];
+    globalThis.__JENZY_TEST_MAILER__ = { sendMail: async (m) => { mails.push(m); return { messageId: 'x' }; } };
+    const telegrams = [];
+    const realFetch = globalThis.fetch;
+    globalThis.fetch = async (url, opts) => {
+        const u = String(url);
+        if (u.startsWith('https://api.telegram.org/')) {
+            const body = JSON.parse(opts?.body || '{}');
+            if (u.endsWith('/sendMessage')) telegrams.push(body.text);
+            return new Response(JSON.stringify({ ok: true, result: u.endsWith('/getMe') ? { username: 'jenzybot' } : [] }), { status: 200 });
+        }
+        return realFetch(url, opts);
+    };
+    return { db, mails, telegrams };
+}
+
+// Calls a Vercel-style handler with a fake req/res
+export async function call(handler, { method = 'GET', query = {}, body, user, headers = {} } = {}) {
+    const req = {
+        method, query, body: body === undefined ? undefined : body,
+        headers: { host: 'localhost:3000', ...headers, ...(user ? { authorization: 'Bearer ' + user } : {}) },
+        url: '/api?' + new URLSearchParams(query)
+    };
+    let status = 200, payload, ended = false;
+    const res = {
+        statusCode: 200,
+        setHeader() {},
+        status(c) { status = c; this.statusCode = c; return this; },
+        json(o) { payload = o; ended = true; return this; },
+        send(o) { payload = o; ended = true; return this; },
+        end(o) { payload = o; ended = true; status = this.statusCode; return this; }
+    };
+    await handler(req, res);
+    return { status, body: payload, ended };
+}

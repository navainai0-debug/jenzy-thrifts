+.gate { max-width: 520px; margin: 40px auto 100px; text-align: center; }
+.gate .gate-icon { width: 72px; height: 72px; border-radius: 20px; margin: 0 auto 20px; background: var(--surface-2); border: 1px solid var(--border); display: flex; align-items: center; justify-content: center; font-size: 28px; color: var(--accent); }
+.gate h2 { font-size: 24px; margin-bottom: 8px; }
+.gate p { color: var(--text-2); margin-bottom: 24px; }
+
+/* ---------- Orders ---------- */
+.success-banner { display: flex; gap: 18px; align-items: center; padding: 22px 24px; border-radius: var(--radius-lg); background: rgba(57, 255, 20, .06); border: 1px solid rgba(57, 255, 20, .35); margin-bottom: 26px; }
+.success-banner i { font-size: 30px; color: var(--accent); }
+.success-banner h3 { font-size: 18px; }
+.success-banner p { color: var(--text-2); font-size: 14px; }
+.order-card { background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius-lg); margin-bottom: 20px; overflow: hidden; }
+.order-head { display: flex; flex-wrap: wrap; gap: 16px; justify-content: space-between; align-items: center; padding: 18px 22px; border-bottom: 1px solid var(--border); background: var(--bg-2); }
+.order-head .o-no { font-weight: 700; font-size: 16px; }
+.order-head .o-date { font-size: 13px; color: var(--text-3); }
+.status-pill { display: inline-flex; align-items: center; gap: 6px; padding: 5px 12px; border-radius: 20px; font-size: 12px; font-weight: 600; }
+.st-Pending { background: rgba(255, 214, 10, .1); color: var(--yellow); border: 1px solid rgba(255, 214, 10, .3); }
+.st-Confirmed { background: rgba(0, 240, 255, .1); color: var(--accent-2); border: 1px solid rgba(0, 240, 255, .3); }
+.st-Shipped { background: rgba(160, 120, 255, .12); color: #b99bff; border: 1px solid rgba(160, 120, 255, .35); }
+.st-Delivered { background: rgba(57, 255, 20, .1); color: var(--accent); border: 1px solid rgba(57, 255, 20, .3); }
+.st-Cancelled { background: rgba(255, 77, 79, .1); color: var(--danger); border: 1px solid rgba(255, 77, 79, .3); }
+.tracker { display: grid; grid-template-columns: repeat(4, 1fr); padding: 22px 22px 8px; }
+.tracker .t-step { position: relative; text-align: center; font-size: 12px; color: var(--text-3); }
+.tracker .t-step::before { content: ''; position: absolute; top: 13px; left: -50%; width: 100%; height: 2px; background: var(--border); z-index: 0; }
+.tracker .t-step:first-child::before { display: none; }
+.tracker .t-dot { position: relative; z-index: 1; width: 28px; height: 28px; margin: 0 auto 8px; border-radius: 50%; background: var(--bg); border: 2px solid var(--border-2); display: flex; align-items: center; justify-content: center; font-size: 11px; }
+.tracker .t-step.done { color: var(--text); }
+.tracker .t-step.done .t-dot { background: var(--accent); border-color: var(--accent); color: #000; }
+.tracker .t-step.done::before { background: var(--accent); }
+.order-body { display: grid; grid-template-columns: 1.4fr 1fr; gap: 24px; padding: 18px 22px 22px; }
+.order-items .sum-item:last-child { border-bottom: none; }
+.order-side { font-size: 14px; color: var(--text-2); }
+.order-side h5 { font-size: 12px; text-transform: uppercase; letter-spacing: 1.5px; color: var(--text-3); margin-bottom: 6px; }
+.order-side .block + .block { margin-top: 16px; }
+.cancelled-note { margin: 0 22px 18px; padding: 12px 14px; border-radius: 12px; background: rgba(255, 77, 79, .06); border: 1px solid rgba(255, 77, 79, .25); color: #ff8a8c; font-size: 13px; }
+
+/* ---------- Responsive ---------- */
+@media (max-width: 1100px) {
+    .p-grid { grid-template-columns: repeat(3, 1fr); }

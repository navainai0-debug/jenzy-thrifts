+        if (u.includes('font-awesome')) {
+            const rel = u.split('/6.5.0/')[1].split('?')[0];
+            const f = path.join(FA, rel);
+            if (fs.existsSync(f)) return route.fulfill({ contentType: rel.endsWith('.css') ? 'text/css' : 'font/woff2', body: fs.readFileSync(f) });
+            return route.fulfill({ status: 404, body: '' });
+        }
+        if (u.includes('fonts.googleapis.com')) return route.fulfill({ contentType: 'text/css', body: '' });
+        if (u.includes('zurvhjraxenbnvmwdurz.supabase.co')) {
+            const r = await fetch(BASE + new URL(u).pathname);
+            return route.fulfill({ status: r.status, headers: { 'content-type': r.headers.get('content-type') || 'image/png', 'access-control-allow-origin': '*' }, body: Buffer.from(await r.arrayBuffer()) });
+        }
+        if (u.includes('images.unsplash.com')) return route.fulfill({ contentType: 'image/png', body: makePng(40, 40) });
+        return route.abort();
+    });

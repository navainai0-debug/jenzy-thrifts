+async function open(ctx, url, user, init) {
+    const page = await ctx.newPage();
+    page.on('pageerror', e => errors.push(`[pageerror] ${url}: ${e.message}`));
+    page.on('console', m => { if (m.type() === 'error') errors.push(`[console] ${url}: ${m.text()}`); });
+    await page.addInitScript(([u, extra]) => {
+        if (u === null) localStorage.removeItem('stubUser'); else if (u) localStorage.setItem('stubUser', u);
+        window.open = (...a) => { const doc = { html: '', open() { this.html = ''; }, write(h) { this.html += h; }, close() { (window.__printed ||= []).push(this.html); } }; return { document: doc, focus() {}, print() {} }; };
+        if (extra) eval(extra);
+    }, [user, init || '']);
+    await page.goto(BASE + url, { waitUntil: 'load' });
+    return page;

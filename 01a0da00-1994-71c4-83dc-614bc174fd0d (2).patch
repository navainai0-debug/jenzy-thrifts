+// Tiny supabase-js look-alike. The query builder produces a plain "spec"
+// object that an executor runs: in Node (fakedb.mjs) directly on PGlite,
+// in the browser by POSTing to /__db (as the anon role).
+
+class Query {
+    constructor(exec, table) {
+        this._exec = exec;
+        this.spec = { table, op: 'select', cols: '*', filters: [], order: [], limit: null, offset: null, single: null, count: null, head: false, values: null, returning: false, onConflict: null, ignoreDuplicates: false };
+    }
+    select(cols = '*', opts = {}) {
+        if (this.spec.op === 'select') {
+            this.spec.cols = cols;
+            if (opts.count) this.spec.count = opts.count;
+            if (opts.head) this.spec.head = true;
+        } else {
+            this.spec.returning = true;
+            this.spec.cols = cols;
+        }
+        return this;
+    }
+    insert(values) { this.spec.op = 'insert'; this.spec.values = Array.isArray(values) ? values : [values]; return this; }
+    upsert(values, opts = {}) {
+        this.spec.op = 'upsert'; this.spec.values = Array.isArray(values) ? values : [values];
+        this.spec.onConflict = opts.onConflict || null; this.spec.ignoreDuplicates = !!opts.ignoreDuplicates; return this;
+    }
+    update(values) { this.spec.op = 'update'; this.spec.values = [values]; return this; }
+    delete() { this.spec.op = 'delete'; return this; }
+    _f(col, op, val) { this.spec.filters.push({ col, op, val }); return this; }
+    eq(c, v) { return this._f(c, 'eq', v); }
+    neq(c, v) { return this._f(c, 'neq', v); }
+    gt(c, v) { return this._f(c, 'gt', v); }
+    gte(c, v) { return this._f(c, 'gte', v); }
+    lt(c, v) { return this._f(c, 'lt', v); }
+    lte(c, v) { return this._f(c, 'lte', v); }
+    in(c, v) { return this._f(c, 'in', v); }
+    is(c, v) { return this._f(c, 'is', v); }
+    contains(c, v) { return this._f(c, 'cs', v); }
+    ilike(c, v) { return this._f(c, 'ilike', v); }
+    not(c, op, v) { return this._f(c, 'not.' + op, v); }
+    filter(c, op, v) { return this._f(c, op, v); }
+    match(obj) { for (const [k, v] of Object.entries(obj)) this.eq(k, v); return this; }
+    or(expr) { this.spec.filters.push({ or: expr }); return this; }
+    order(col, opts = {}) { this.spec.order.push({ col, asc: opts.ascending !== false, nullsFirst: opts.nullsFirst }); return this; }
+    limit(n) { this.spec.limit = n; return this; }
+    range(a, b) { this.spec.offset = a; this.spec.limit = b - a + 1; return this; }
+    single() { this.spec.single = 'one'; return this; }
+    maybeSingle() { this.spec.single = 'maybe'; return this; }
+    then(res, rej) { return Promise.resolve().then(() => this._exec(this.spec)).then(res, rej); }
+}
+
+function makeClient(exec, extra = {}) {
+    const channels = [];
+    return {
+        from: (table) => new Query(exec, table),
+        rpc: (fn, args) => ({ then: (res, rej) => Promise.resolve().then(() => exec({ rpc: fn, args: args || {} })).then(res, rej) }),
+        channel(name) {
+            const ch = { name, on() { return ch; }, subscribe(cb) { if (cb) setTimeout(() => cb('SUBSCRIBED'), 0); return ch; }, unsubscribe() {} };
+            channels.push(ch);
+            return ch;
+        },
+        removeChannel() { return Promise.resolve(); },
+        auth: { getSession: async () => ({ data: { session: null } }) },
+        storage: extra.storage || {
+            from: (bucket) => ({
+                uploadToSignedUrl: async (path, token, file) => {
+                    const r = await fetch('/__upload?path=' + encodeURIComponent(path), { method: 'POST', body: file, headers: { 'content-type': file.type || 'application/octet-stream' } });
+                    return r.ok ? { data: { path }, error: null } : { data: null, error: { message: 'upload failed' } };
+                },
+                getPublicUrl: (path) => ({ data: { publicUrl: location.origin + '/storage/v1/object/public/' + bucket + '/' + path } })
+            })
+        }
+    };
+}
+
+// Browser entry point (replaces the CDN supabase-js UMD script)
+function createClient() {
+    return makeClient(async (spec) => {
+        const r = await fetch('/__db', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify(spec) });
+        return r.json();
+    });
+}
+globalThis.__SBStub = { makeClient };
+if (typeof window !== 'undefined') window.supabase = { createClient };

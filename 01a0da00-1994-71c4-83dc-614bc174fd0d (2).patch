+.size-error.show { display: block; }
+.pd-actions { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-top: 26px; }
+.pd-soldout { margin-top: 26px; padding: 16px; border-radius: var(--radius); background: var(--surface); border: 1px solid var(--border); text-align: center; color: var(--text-2); }

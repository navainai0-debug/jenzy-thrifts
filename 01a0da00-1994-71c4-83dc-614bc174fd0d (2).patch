+.related-head .section-title { font-size: 26px; }
+
+/* Mobile sticky buy bar (product page) */
+.buy-bar { display: none; }
+
+/* In-app browser notice (Instagram / Facebook / TikTok) */
+.inapp-note { text-align: left; font-size: 13px; line-height: 1.5; color: var(--text-2); background: rgba(255, 214, 10, .07); border: 1px solid rgba(255, 214, 10, .35); border-radius: 12px; padding: 12px 14px; margin-bottom: 16px; }
+.inapp-note strong { color: var(--yellow); display: block; margin-bottom: 4px; }

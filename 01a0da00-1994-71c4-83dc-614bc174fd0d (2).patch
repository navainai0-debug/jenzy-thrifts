+await page.close();
+page = await open(shop, '/', null);
+await page.waitForSelector('.review-card', { timeout: 8000 });
+await page.waitForFunction(() => document.querySelectorAll('.review-card').length === 2, null, { timeout: 5000 }).catch(() => {});
+ok(await page.locator('.review-card').count() === 2 && await page.locator('.review-card .rc-photos img').count() === 2, 'approved photo review now on home page');
+await shot(page, 'home-desktop');
+await page.close();
+
+// ---------- Mobile layouts ----------
+for (const [w, h] of [[390, 844], [320, 640]]) {
+    console.log(`\nMobile ${w}px`);
+    const m = await newCtx({ viewport: { width: w, height: h }, isMobile: true, hasTouch: true, deviceScaleFactor: 2 });
+    let pg = await open(m, '/', null);
+    await pg.waitForSelector('.review-card');
+    await noOverflow(pg, `home ${w}`);
+    await pg.evaluate(() => document.getElementById('reviews').scrollIntoView());
+    await shot(pg, `home-reviews-${w}`, false);
+    await pg.close();
+    pg = await open(m, `/shoe/${P1.id}`, null);
+    await pg.waitForSelector('#buyNow', { state: 'attached' });
+    await noOverflow(pg, `product ${w}`);
+    await pg.click('[data-size-guide]');
+    await pg.fill('#sgCm', '27');

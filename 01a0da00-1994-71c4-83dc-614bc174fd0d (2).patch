+ok(printed.length === 2 && /INVOICE/.test(printed[0]) && printed[0].includes(`JT-${zid.order_no}`) && /Invite code/.test(printed[0]) && /size: A5/.test(printed[0]), 'invoice printed (A5, discount label)');
+ok(/lbl-page/.test(printed[1]) && /100mm 150mm/.test(printed[1]) && /Islamabad/.test(printed[1]) && /4,?[0-9]{3}/.test(printed[1]), 'label printed (100×150 mm, city, COD)');
+fs.writeFileSync(path.join(SHOTS, 'invoice.html'), printed[0]);
+fs.writeFileSync(path.join(SHOTS, 'label.html'), printed[1]);
+await page.click('#orderModal [data-close-modal]');
+await page.click('#printLabels');
+printed = await page.evaluate(() => window.__printed);
+ok((printed[2].match(/class="lbl-page"/g) || []).length === 3, 'bulk print: 3 labels');
+await page.check(`#ordersTable [data-sel="${zid.id}"]`);
+ok(/\(1\)/.test(await page.textContent('#exportCsv')), 'ticking an order limits export to it');
+const [csvDl] = await Promise.all([page.waitForEvent('download'), page.click('#exportCsv')]);
+const csv = fs.readFileSync(await csvDl.path(), 'utf8');
+ok(csv.charCodeAt(0) === 0xfeff && csv.includes('\r\n'), 'CSV has BOM + Windows line ends');
+const lines = csv.replace(/^\ufeff/, '').trim().split('\r\n');
+ok(lines.length === 2 && lines[0].startsWith('Order Ref,Consignee Name,Consignee Phone') && lines[1].includes('03211234567') && lines[1].includes('Islamabad') && lines[1].includes(',4300,') && lines[1].includes('"House 3, Street 20, F-7/2, F-7"'), 'CSV row for the ticked order', lines);

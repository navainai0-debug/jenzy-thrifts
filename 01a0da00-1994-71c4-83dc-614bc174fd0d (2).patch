+++ b/dev-tests/checkjs.mjs
@@ -0,0 +1,18 @@
+import fs from 'fs';
+import { execFileSync } from 'child_process';
+let bad = 0;
+for (const f of fs.readdirSync('.').filter(f => f.endsWith('.html'))) {
+  const html = fs.readFileSync(f, 'utf8');
+  const re = /<script(?![^>]*\bsrc=)[^>]*>([\s\S]*?)<\/script>/g; let m, i = 0;
+  while ((m = re.exec(html))) {
+    i++;
+    if (/type="application\/ld\+json"/.test(m[0].slice(0, 80))) continue;
+    const tmp = `/tmp/chk_${f}_${i}.mjs`;
+    fs.writeFileSync(tmp, m[1]);
+    try { execFileSync('node', ['--check', tmp], { stdio: 'pipe' }); }
+    catch (e) { bad++; console.log('FAIL', f, i, e.stderr.toString().split('\n').slice(0, 6).join('\n')); }
+  }
+  console.log('ok', f, i);
+}
+for (const f of ['assets/js/store.js', 'assets/js/config.js']) { try { execFileSync('node', ['--check', f]); } catch (e) { bad++; console.log('FAIL', f, e.stderr.toString()); } }
+process.exit(bad ? 1 : 0);

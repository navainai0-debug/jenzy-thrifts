@@ -0,0 +1,1099 @@
+/* =====================================================================
+   JENZY THRIFTS — Store styles
+   ===================================================================== */
+:root {
+    --accent: #39ff14;
+    --accent-2: #00f0ff;
+    --pink: #ff2d95;
+    --yellow: #ffd60a;
+    --danger: #ff4d4f;
+    --bg: #0a0a0b;
+    --bg-2: #0f0f11;
+    --surface: #141417;
+    --surface-2: #1b1b1f;
+    --border: #26262b;
+    --border-2: #34343a;
+    --text: #f5f5f7;
+    --text-2: #b4b4bc;
+    --text-3: #7c7c86;
+    --radius: 14px;
+    --radius-lg: 20px;
+    --gradient: linear-gradient(135deg, var(--accent), var(--accent-2));
+    --shadow: 0 20px 50px rgba(0, 0, 0, .45);
+    --header-h: 72px;
+    --container: 1280px;
+    --font-display: 'Orbitron', sans-serif;
+    --font-body: 'Poppins', system-ui, -apple-system, 'Segoe UI', sans-serif;
+}
+
+* { margin: 0; padding: 0; box-sizing: border-box; }
+[hidden] { display: none !important; }
+html { -webkit-text-size-adjust: 100%; text-size-adjust: 100%; }
+a, button { -webkit-tap-highlight-color: transparent; touch-action: manipulation; }
+html { scroll-behavior: smooth; scroll-padding-top: calc(var(--header-h) + 16px); }
+body {
+    font-family: var(--font-body);
+    background: var(--bg);
+    color: var(--text);
+    line-height: 1.6;
+    -webkit-font-smoothing: antialiased;
+    overflow-x: hidden;
+}
+a { color: inherit; text-decoration: none; }
+img { display: block; max-width: 100%; }
+button, input, select, textarea { font-family: inherit; font-size: inherit; color: inherit; }
+button { cursor: pointer; }
+ul { list-style: none; }
+::selection { background: var(--accent); color: #000; }
+::-webkit-scrollbar { width: 8px; }
+::-webkit-scrollbar-track { background: var(--bg); }
+::-webkit-scrollbar-thumb { background: #2c2c33; border-radius: 10px; }
+::-webkit-scrollbar-thumb:hover { background: var(--accent); }
+
+.container { width: 100%; max-width: var(--container); margin: 0 auto; padding: 0 24px; }
+.hidden { display: none !important; }
+.muted { color: var(--text-3); }
+
+/* ---------- Buttons ---------- */
+.btn {
+    display: inline-flex; align-items: center; justify-content: center; gap: 10px;
+    padding: 13px 26px; border-radius: 12px; border: 1px solid transparent;
+    font-weight: 600; font-size: 15px; line-height: 1; white-space: nowrap;
+    transition: transform .2s, box-shadow .2s, background .2s, border-color .2s, color .2s;
+}
+.btn:disabled { opacity: .55; cursor: not-allowed; transform: none !important; box-shadow: none !important; }
+.btn-primary { background: var(--gradient); color: #041006; }
+.btn-primary:hover:not(:disabled) { transform: translateY(-1px); box-shadow: 0 10px 30px rgba(57, 255, 20, .25); }
+.btn-outline { border-color: var(--border-2); background: transparent; color: var(--text); }
+.btn-outline:hover:not(:disabled) { border-color: var(--accent); color: var(--accent); }
+.btn-dark { background: var(--surface-2); border-color: var(--border); color: var(--text); }
+.btn-dark:hover:not(:disabled) { border-color: var(--border-2); }
+.btn-danger { background: transparent; border-color: rgba(255, 77, 79, .5); color: var(--danger); }
+.btn-danger:hover:not(:disabled) { background: var(--danger); color: #fff; }
+.btn-block { width: 100%; }
+.btn-lg { padding: 16px 30px; font-size: 16px; }
+.btn-sm { padding: 9px 16px; font-size: 13px; border-radius: 10px; }
+
+/* ---------- Announcement ---------- */
+.announce {
+    background: #050505; border-bottom: 1px solid var(--border);
+    color: var(--text-2); font-size: 12.5px; letter-spacing: .3px;
+    text-align: center; padding: 9px 16px;
+}
+.announce strong { color: var(--accent); font-weight: 600; }
+.announce { overflow: hidden; white-space: nowrap; }
+.announce-track { display: inline-block; }
+.announce-track span + span { display: none; }
+
+/* ---------- Header ---------- */
+.site-header {
+    position: sticky; top: 0; z-index: 900;
+    background: rgba(10, 10, 11, .86);
+    backdrop-filter: saturate(160%) blur(16px);
+    -webkit-backdrop-filter: saturate(160%) blur(16px);
+    border-bottom: 1px solid var(--border);
+}
+.header-inner {
+    height: var(--header-h);
+    display: grid; grid-template-columns: auto 1fr auto; align-items: center; gap: 32px;
+}
+.brand { display: inline-flex; align-items: baseline; gap: 8px; line-height: 1; }
+.brand-main {
+    font-family: var(--font-display); font-weight: 900; font-size: 24px; letter-spacing: 2px;
+    background: var(--gradient); -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent;
+}
+.brand-sub { font-family: var(--font-display); font-weight: 600; font-size: 12px; letter-spacing: 4px; color: var(--text-2); }
+.main-nav { display: flex; justify-content: center; gap: 6px; }
+.main-nav a {
+    padding: 8px 14px; border-radius: 10px;
+    font-size: 14px; font-weight: 500; color: var(--text-2);
+    transition: color .2s, background .2s;
+}
+.main-nav a:hover { color: var(--text); background: var(--surface); }
+.main-nav a.active { color: var(--accent); }
+.header-actions { display: flex; align-items: center; justify-content: flex-end; gap: 10px; grid-column: 3; }
+.icon-btn {
+    position: relative; width: 42px; height: 42px; border-radius: 12px;
+    display: inline-flex; align-items: center; justify-content: center;
+    background: transparent; border: 1px solid var(--border); color: var(--text); font-size: 17px;
+    transition: border-color .2s, color .2s;
+}
+.icon-btn:hover { border-color: var(--accent); color: var(--accent); }
+.cart-count {
+    position: absolute; top: -6px; right: -6px; min-width: 19px; height: 19px; padding: 0 5px;
+    border-radius: 10px; background: var(--accent); color: #000;
+    font-size: 11px; font-weight: 700; display: flex; align-items: center; justify-content: center;
+}
+.cart-count.zero { display: none; }
+.login-btn {
+    display: inline-flex; align-items: center; gap: 8px; height: 42px; padding: 0 18px;
+    border-radius: 12px; border: 1px solid var(--border-2); background: transparent;
+    color: var(--text); font-weight: 600; font-size: 14px; transition: border-color .2s, color .2s;
+}
+.login-btn:hover { border-color: var(--accent); color: var(--accent); }
+.menu-btn { display: none; }
+
+.account { position: relative; }
+.account-btn {
+    display: inline-flex; align-items: center; gap: 10px; height: 42px; padding: 0 12px 0 5px;

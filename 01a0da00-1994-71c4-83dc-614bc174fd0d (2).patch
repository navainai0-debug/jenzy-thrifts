+// Extracts @sparticuz/chromium into /tmp (run once after a sandbox reset)
+import fs from 'fs'; import zlib from 'zlib'; import { execSync } from 'child_process';
+const BIN = new URL('./node_modules/@sparticuz/chromium/bin/', import.meta.url).pathname;
+const br = (f) => zlib.brotliDecompressSync(fs.readFileSync(BIN + f));
+if (!fs.existsSync('/tmp/chromium')) { fs.writeFileSync('/tmp/chromium', br('chromium.br')); fs.chmodSync('/tmp/chromium', 0o755); }
+for (const [f, dir] of [['al2023.tar.br', '/tmp/al2023'], ['fonts.tar.br', '/tmp'], ['swiftshader.tar.br', '/tmp']]) {
+  fs.mkdirSync(dir, { recursive: true });
+  fs.writeFileSync('/tmp/x.tar', br(f));
+  execSync(`tar -xf /tmp/x.tar -C ${dir}`);
+}
+console.log(execSync('ls /tmp /tmp/al2023 | head -40').toString());

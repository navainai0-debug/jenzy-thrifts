diff --git a/dev-tests/fakedb.mjs b/dev-tests/fakedb.mjs
new file mode 100644
index 0000000..7279958
--- /dev/null
+++ b/dev-tests/fakedb.mjs
@@ -0,0 +1,224 @@
+// A supabase-js look-alike running on PGlite (real Postgres in WASM).
+// makeDb() -> client used as globalThis.__JENZY_TEST_DB__ by the API code.
+//   db.pg          raw PGlite
+//   db.anon(spec)  run a query spec as the anon role (browser)
+//   db.run(spec)   run a query spec as service role (superuser)
+//   db.removed     storage paths deleted via storage.remove()
+import { PGlite } from '@electric-sql/pglite';
+import fs from 'node:fs';
+import path from 'node:path';
+import { fileURLToPath } from 'node:url';
+import './stubs/supabase.js';
+
+const here = path.dirname(fileURLToPath(import.meta.url));
+const ROOT = path.resolve(here, '..');
+export const PUBLIC_BASE = 'https://zurvhjraxenbnvmwdurz.supabase.co/storage/v1/object/public/';
+
+const PRELUDE = `
+do $$ begin
+  if not exists (select 1 from pg_roles where rolname = 'anon') then create role anon nologin; end if;
+  if not exists (select 1 from pg_roles where rolname = 'authenticated') then create role authenticated nologin; end if;
+  if not exists (select 1 from pg_roles where rolname = 'service_role') then create role service_role nologin bypassrls; end if;
+end $$;
+grant usage on schema public to anon, authenticated, service_role;
+alter default privileges in schema public grant all on tables to anon, authenticated, service_role;
+alter default privileges in schema public grant all on sequences to anon, authenticated, service_role;
+alter default privileges in schema public grant all on functions to anon, authenticated, service_role;
+create schema if not exists storage;
+create table if not exists storage.buckets (id text primary key, name text, public boolean default false);
+create publication supabase_realtime;
+`;
+
+function arrLit(arr) {
+    return '{' + arr.map(v => v === null || v === undefined ? 'NULL' : '"' + String(v).replace(/\\/g, '\\\\').replace(/"/g, '\\"') + '"').join(',') + '}';
+}
+
+export async function makeDb({ sql } = {}) {
+    const pg = new PGlite();
+    await pg.exec(PRELUDE);
+    await pg.exec(sql || fs.readFileSync(path.join(ROOT, 'supabase-setup.sql'), 'utf8'));
+
+    let types = null;   // table -> col -> type
+    let pks = null;
+    const fnCache = {};
+    async function loadTypes() {
+        const r = await pg.query(`select c.relname t, a.attname c, format_type(a.atttypid, a.atttypmod) ty
+            from pg_attribute a join pg_class c on c.oid = a.attrelid join pg_namespace n on n.oid = c.relnamespace
+            where n.nspname = 'public' and c.relkind = 'r' and a.attnum > 0 and not a.attisdropped`);
+        types = {};
+        for (const row of r.rows) (types[row.t] ||= {})[row.c] = row.ty;
+        const k = await pg.query(`select c.relname t, a.attname c from pg_index i join pg_class c on c.oid = i.indrelid
+            join pg_namespace n on n.oid = c.relnamespace join pg_attribute a on a.attrelid = c.oid and a.attnum = any(i.indkey)
+            where n.nspname = 'public' and i.indisprimary`);
+        pks = {};
+        for (const row of k.rows) (pks[row.t] ||= []).push(row.c);
+    }
+    async function fnTypes(name) {
+        if (fnCache[name]) return fnCache[name];
+        const r = await pg.query(`select p.proargnames n, array(select format_type(t, null) from unnest(p.proargtypes::oid[]) t) ty
+            from pg_proc p join pg_namespace ns on ns.oid = p.pronamespace where ns.nspname = 'public' and p.proname = $1`, [name]);
+        if (!r.rows.length) throw Object.assign(new Error(`function public.${name} does not exist`), { code: 'PGRST202' });
+        const m = {};
+        r.rows[0].n.forEach((n, i) => { m[n] = r.rows[0].ty[i]; });
+        return (fnCache[name] = m);
+    }
+
+    function enc(val, ty) {
+        if (val === null || val === undefined) return null;
+        if (ty && ty.endsWith('[]')) return Array.isArray(val) ? arrLit(val) : String(val);
+        if (ty === 'jsonb' || ty === 'json') return JSON.stringify(val);
+        if (val instanceof Date) return val.toISOString();
+        if (typeof val === 'object') return JSON.stringify(val);
+        return String(val);
+    }
+
+    function build(spec) {
+        const t = spec.table;
+        const cols = types[t];
+        if (!cols) throw Object.assign(new Error(`relation "public.${t}" does not exist`), { code: '42P01' });
+        const params = [];
+        const p = (val, ty) => { params.push(enc(val, ty)); return `$${params.length}::text::${ty || 'text'}`; };
+        const ident = (c) => {
+            if (!cols[c]) throw Object.assign(new Error(`column ${t}.${c} does not exist`), { code: '42703' });
+            return '"' + c + '"';
+        };
+        const cond = (col, op, val) => {
+            const ty = cols[col];
+            const c = ident(col);
+            if (op.startsWith('not.')) return `not (${cond(col, op.slice(4), val)})`;
+            switch (op) {
+                case 'eq': return `${c} = ${p(val, ty)}`;
+                case 'neq': return `${c} <> ${p(val, ty)}`;
+                case 'gt': return `${c} > ${p(val, ty)}`;
+                case 'gte': return `${c} >= ${p(val, ty)}`;
+                case 'lt': return `${c} < ${p(val, ty)}`;
+                case 'lte': return `${c} <= ${p(val, ty)}`;
+                case 'ilike': return `${c} ilike ${p(val, 'text')}`;
+                case 'like': return `${c} like ${p(val, 'text')}`;
+                case 'cs': return `${c} @> ${p(val, ty)}`;
+                case 'in': {
+                    let list = val;
+                    if (typeof list === 'string') list = list.replace(/^\(|\)$/g, '').split(',').map(s => s.trim().replace(/^"|"$/g, ''));
+                    return `${c} = any(${p(list, (ty.endsWith('[]') ? 'text' : ty) + '[]')})`;
+                }
+                case 'is': {
+                    const v = val === null || val === 'null' ? 'null' : (val === true || val === 'true') ? 'true' : 'false';
+                    return `${c} is ${v}`;
+                }
+                default: throw new Error('unsupported filter ' + op);
+            }
+        };
+        const where = () => {
+            const parts = [];
+            for (const f of spec.filters) {
+                if (f.or) {
+                    const ors = f.or.split(/,(?![^(]*\))/).map(s => {
+                        const m = s.match(/^([^.]+)\.(not\.)?([a-z]+)\.(.*)$/);
+                        if (!m) throw new Error('bad or() ' + s);
+                        return cond(m[1], (m[2] || '') + m[3], m[4]);
+                    });
+                    parts.push('(' + ors.join(' or ') + ')');
+                } else parts.push(cond(f.col, f.op, f.val));
+            }
+            return parts.length ? ' where ' + parts.join(' and ') : '';
+        };
+        const colList = (s) => {
+            s = (s || '*').trim();
+            if (s === '*') return '*';
+            return s.split(',').map(x => x.trim()).filter(Boolean).map(ident).join(', ');
+        };
+        const T = `public."${t}"`;
+
+        if (spec.op === 'select') {
+            const w = where();
+            let q = `select ${colList(spec.cols)} from ${T}${w}`;
+            if (spec.order.length) q += ' order by ' + spec.order.map(o => `${ident(o.col)} ${o.asc ? 'asc' : 'desc'}${o.nullsFirst === undefined ? '' : o.nullsFirst ? ' nulls first' : ' nulls last'}`).join(', ');
+            if (spec.limit != null) q += ` limit ${Number(spec.limit)}`;
+            if (spec.offset != null) q += ` offset ${Number(spec.offset)}`;
+            const countSql = spec.count ? `select count(*)::int n from ${T}${w}` : null;
+            return { sql: `select to_jsonb(t) r from (${q}) t`, params, countSql, head: spec.head };
+        }
+        const ret = spec.returning ? colList(spec.cols) : null;
+        const wrap = (q) => ret ? `with t as (${q} returning ${ret}) select to_jsonb(t) r from t` : q;
+        if (spec.op === 'insert' || spec.op === 'upsert') {
+            const names = [...new Set(spec.values.flatMap(v => Object.keys(v)))];
+            names.forEach(ident);
+            const rows = spec.values.map(v => '(' + names.map(n => n in v && v[n] !== undefined ? p(v[n], cols[n]) : 'default').join(', ') + ')');
+            let q = `insert into ${T} (${names.map(n => '"' + n + '"').join(', ')}) values ${rows.join(', ')}`;
+            if (spec.op === 'upsert') {
+                const target = spec.onConflict ? spec.onConflict.split(',').map(s => s.trim()) : pks[t];
+                q += ` on conflict (${target.map(ident).join(', ')}) ` + (spec.ignoreDuplicates
+                    ? 'do nothing'
+                    : 'do update set ' + names.map(n => `"${n}" = excluded."${n}"`).join(', '));
+            }
+            return { sql: wrap(q), params };
+        }
+        if (spec.op === 'update') {
+            const v = spec.values[0];
+            const sets = Object.keys(v).filter(k => v[k] !== undefined).map(k => `${ident(k)} = ${p(v[k], cols[k])}`);
+            return { sql: wrap(`update ${T} set ${sets.join(', ')}${where()}`), params };
+        }
+        if (spec.op === 'delete') return { sql: wrap(`delete from ${T}${where()}`), params };
+        throw new Error('bad op ' + spec.op);
+    }
+
+    async function exec(spec, role) {
+        try {
+            if (!types) await loadTypes();
+            let built;
+            if (spec.rpc) {
+                const ft = await fnTypes(spec.rpc);
+                const params = [];
+                const args = Object.entries(spec.args || {}).map(([k, v]) => {
+                    if (!(k in ft)) throw Object.assign(new Error(`Could not find the function public.${spec.rpc} with argument ${k}`), { code: 'PGRST202' });
+                    params.push(enc(v, ft[k]));
+                    return `"${k}" => $${params.length}::text::${ft[k]}`;
+                });
+                built = { sql: `select to_jsonb(public."${spec.rpc}"(${args.join(', ')})) r`, params, rpc: true };
+            } else built = build(spec);
+
+            const runIn = async (q) => {
+                const res = await q.query(built.sql, built.params);
+                const count = built.countSql ? (await q.query(built.countSql, built.params)).rows[0].n : null;
+                return { rows: res.rows, count };
+            };
+            let out;
+            if (role) {
+                out = await pg.transaction(async (tx) => {
+                    await tx.exec(`set local role ${role}`);
+                    return runIn(tx);
+                });
+            } else out = await runIn(pg);
+
+            if (built.rpc) return { data: out.rows[0] ? out.rows[0].r : null, error: null };
+            let data = out.rows.map(r => r.r);
+            if (!spec.returning && spec.op !== 'select') data = null;
+            if (built.head) data = null;
+            if (spec.single) {
+                if (spec.single === 'one' && (!data || data.length !== 1)) return { data: null, error: { message: 'JSON object requested, multiple (or no) rows returned', code: 'PGRST116' } };
+                if (data && data.length > 1) return { data: null, error: { message: 'JSON object requested, multiple (or no) rows returned', code: 'PGRST116' } };
+                data = data && data.length ? data[0] : null;
+            }
+            return { data, error: null, count: out.count };
+        } catch (e) {
+            return { data: null, error: { message: e.message, code: e.code || null, details: e.detail || null, hint: e.hint || null } };
+        }
+    }
+
+    const removed = [];
+    const storage = {
+        from: (bucket) => ({
+            createSignedUploadUrl: async (p) => ({ data: { signedUrl: PUBLIC_BASE.replace('/public/', '/upload/sign/') + bucket + '/' + p + '?token=tok', token: 'tok', path: p }, error: null }),
+            remove: async (paths) => { removed.push(...paths); return { data: paths.map(name => ({ name })), error: null }; },
+            getPublicUrl: (p) => ({ data: { publicUrl: PUBLIC_BASE + bucket + '/' + p } })
+        })
+    };
+    const client = globalThis.__SBStub.makeClient((spec) => exec(spec, null), { storage });
+    client.pg = pg;
+    client.run = (spec) => exec(spec, null);
+    client.anon = (spec) => exec(spec, 'anon');
+    client.anonClient = globalThis.__SBStub.makeClient((spec) => exec(spec, 'anon'));
+    client.removed = removed;
+    client.reloadTypes = loadTypes;
+    return client;
+}

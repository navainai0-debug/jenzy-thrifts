{
  "rewrites": [
    { "source": "/shoe/:id", "destination": "/api/shoe?id=:id" },
    { "source": "/assets/img/:img", "destination": "/api/shoe?img=:img" },
    { "source": "/sitemap.xml", "destination": "/api/sitemap" },
    { "source": "/blog", "destination": "/api/pages?type=blog" },
    { "source": "/blog/:slug", "destination": "/api/pages?type=post&slug=:slug" },
    { "source": "/brands", "destination": "/api/pages?type=brands" },
    { "source": "/brand/:slug", "destination": "/api/pages?type=brand&slug=:slug" },
    { "source": "/city/:slug", "destination": "/api/pages?type=city&slug=:slug" },
    { "source": "/c/:t", "destination": "/api/pages?type=confirm&t=:t" },
    { "source": "/verify/:code", "destination": "/api/pages?type=verify&code=:code" },
    { "source": "/:file(google[a-zA-Z0-9]+\\.html)", "destination": "/api/sitemap?gsv=:file" },
    { "source": "/admin", "destination": "/admin.html" },
    { "source": "/orders", "destination": "/orders.html" },
    { "source": "/wishlist", "destination": "/wishlist.html" },
    { "source": "/checkout", "destination": "/checkout.html" },
    { "source": "/sell", "destination": "/sell.html" },
    { "source": "/product", "destination": "/product.html" }
  ],
  "functions": {
    "api/shoe.js": { "includeFiles": "product.html" }
  },
  "crons": [
    { "path": "/api/cron", "schedule": "0 11 * * *" }
  ]
}
